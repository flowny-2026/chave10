# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Segurança JWT ────────────────────────────────────────────
# OBRIGATÓRIO: gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio_de_pelo_menos_64_chars

# ─── Senha inicial do master_admin ───────────────────────────
# RECOMENDADO: defina antes do primeiro deploy. Se ausente, usa 'admin123' (inseguro em produção).
# Troque via /api/admin/trocar-senha após o primeiro login.
MASTER_ADMIN_PASSWORD=troque_antes_do_deploy

# ─── CORS / Frontend ─────────────────────────────────────────
FRONTEND_URL=https://seusite.vercel.app
FRONTEND_URL_2=              # domínio customizado opcional (ex: https://chave10.com.br)

# ─── Banco de dados PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/chave10

# SSL em produção (padrão: rejectUnauthorized=true — mais seguro).
# Defina como 'false' SOMENTE se seu provedor usar certificado auto-assinado
# e você tiver validado a CA manualmente (ex.: Railway free tier).
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ─── Proxy reverso ───────────────────────────────────────────
# Em produção atrás de Nginx/Heroku/Render/Railway, defina como 1.
# Necessário para req.ip correto no rate limiting e nos logs.
# TRUST_PROXY=1   (controlado por NODE_ENV no código — não precisa definir aqui)

# ─── Backup automático ────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24

# ─── Google OAuth (opcional — login com Gmail) ────────────────
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com

# ─── Seed demo (deixe vazio em produção para desabilitar) ─────
SEED_KEY=

# ─── Aprovação de Orçamentos via WhatsApp ────────────────────
WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_API_TOKEN=seu_token_whatsapp_aqui
PUBLIC_URL=https://seusite.vercel.app
DEFAULT_LINK_VALIDITY_HOURS=168
MAX_LINK_VALIDITY_HOURS=2160
