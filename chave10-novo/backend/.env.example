# ══════════════════════════════════════════════════════════════════════
# Chave 10 — Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════════════
# Copie este arquivo como .env e preencha os valores.
# NUNCA comite o arquivo .env no repositório.
# ══════════════════════════════════════════════════════════════════════

# ─── Servidor ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Opções: development | production | test

# Timeout máximo de requisição em ms (padrão: 30000 = 30s).
# Protege contra slowloris e conexões penduradas.
REQUEST_TIMEOUT_MS=30000

# ─── Segurança JWT (OBRIGATÓRIA) ─────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo: 32 caracteres. Recomendado: 128 hex chars.
JWT_SECRET=

# ─── Senha inicial do master_admin ───────────────────────────────────
# Obrigatória em produção. Mínimo 8 caracteres. Não use 'admin123'.
# Troque via /api/admin/trocar-senha após o primeiro login.
MASTER_ADMIN_PASSWORD=

# ─── CORS / Frontend (OBRIGATÓRIA em produção) ───────────────────────
# URL exata do frontend no Vercel. Sem barra final.
FRONTEND_URL=
# Domínio customizado opcional (ex: https://chave10.com.br)
FRONTEND_URL_2=

# ─── Banco de dados PostgreSQL (OBRIGATÓRIA) ─────────────────────────
# Connection string completa. Exemplo:
# postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# SSL em produção: aceita auto-assinados por padrão (compatível com Render).
# Defina como 'true' APENAS se seu provedor usa certificado com CA reconhecida.
# DATABASE_SSL_STRICT=true

# ─── Backup automático ────────────────────────────────────────────────
# Intervalo entre backups automáticos (em horas). Padrão: 24.
BACKUP_INTERVAL_HOURS=24

# ─── Google OAuth (opcional — login com Gmail) ────────────────────────
# Se deixar vazio, o botão Google não aparece no login.
# Deve terminar com .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ─── Seed demo (deixe vazio em produção para desabilitar) ─────────────
# Chave secreta para habilitar o endpoint /seed-demo. Vazio = desabilitado.
SEED_KEY=

# ─── Aprovação de Orçamentos via WhatsApp (opcional) ──────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# URL pública do frontend (usada para gerar links de aprovação)
PUBLIC_URL=
# Validade padrão e máxima dos links de aprovação (em horas)
DEFAULT_LINK_VALIDITY_HOURS=168
MAX_LINK_VALIDITY_HOURS=2160
